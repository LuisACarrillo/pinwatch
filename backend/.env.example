# Copia este archivo a backend/.env (está en .gitignore) y ajusta los valores.
# Cárgalo antes de uvicorn con: set -a; source backend/.env; set +a
# Ninguna variable es obligatoria en la nube: ahí todo sale del secreto pinwatch/app.

# Nombre del secreto en AWS Secrets Manager.
APP_SECRET_NAME=pinwatch/app
# Segundos que el secreto se guarda en memoria antes de releerlo.
APP_SECRET_TTL_SECONDS=300

# Respaldo local: si se definen, ganan sobre el secreto y no se llama a AWS.
# Genera una llave con: openssl rand -hex 64
JWT_SIGNING_KEY=
JWT_ALGORITHM=HS256

DB_HOST=localhost
DB_PORT=5432
DB_NAME=pinwatch
DB_USERNAME=
DB_PASSWORD=
# Si RDS administra la contraseña, en lugar de DB_USERNAME y DB_PASSWORD:
DB_SECRET_ARN=

# Amazon SNS para notificaciones asíncronas de eventos
SNS_TOPIC_ARN=
